# Copy to server/.env (npm run setup does this for you).
# PostgreSQL started by `npm run db:up` (docker compose). Change if you use a local Postgres install.
DATABASE_URL="postgresql://btree:btree@localhost:5432/btree?schema=public"

# API
PORT=4000
NODE_ENV=development
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# Comma-separated list of origins allowed to call the API with cookies
CORS_ORIGIN="http://localhost:5173"
